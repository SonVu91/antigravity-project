# ==============================================================================
# CARDANO & MIDNIGHT AI SENTINEL & AUTO-TRADER CONFIGURATION TEMPLATE
# Sao chép tệp này thành config/.env và điền các API key của bạn
# ==============================================================================

# ----------------- CHẾ ĐỘ VẬN HÀNH -----------------
# alert_only: Chỉ phát tín hiệu cảnh báo qua Telegram
# paper_trading: Giao dịch giả lập với chi phí & độ trễ thực tế
# live_trading: Giao dịch tiền thật (Cần kiểm thử tối thiểu 14 ngày)
BOT_MODE=paper_trading
LOG_LEVEL=INFO

# ----------------- TÀI SẢN MỤC TIÊU -----------------
# CEX Pairs
CEX_ADA_PAIR=ADA/USDT
CEX_NIGHT_PAIR=NIGHT/USDT
DEFAULT_CEX_EXCHANGE=binance

# Cardano DEX Pairs & Pools
DEX_ADA_PAIR=ADA/USDC
DEX_NIGHT_PAIR=NIGHT/ADA
# Policy ID của token NIGHT trên Cardano (Mainnet)
NIGHT_POLICY_ID=
NIGHT_ASSET_NAME_HEX=

# ----------------- SỐ DƯ GIẢ LẬP (PAPER TRADING) -----------------
PAPER_INITIAL_USDT=10000.0
PAPER_INITIAL_ADA=10000.0
PAPER_INITIAL_NIGHT=0.0

# ----------------- QUẢN TRỊ RỦI RO (RISK MANAGEMENT) -----------------
# Tỷ lệ rủi ro tối đa trên mỗi giao dịch (% NAV)
MAX_RISK_PER_TRADE_PCT=1.5
# Ngưỡng ngắt mạch tự động trong 24h (% Drawdown)
CIRCUIT_BREAKER_DRAWDOWN_PCT=5.0
# Hệ số nhân ATR cho Stop-Loss
ATR_SL_MULTIPLIER=1.5
# Tỷ lệ Risk:Reward cho Take-Profit
TAKE_PROFIT_RR_RATIO=2.0

# ----------------- CARDANO ON-CHAIN API -----------------
# Đăng ký miễn phí tại https://blockfrost.io
BLOCKFROST_PROJECT_ID=
BLOCKFROST_NETWORK=mainnet

# ----------------- GOOGLE GEMINI API (AI SENTIMENT) -----------------
# Lấy API key tại https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ----------------- TELEGRAM BOT -----------------
# Tạo bot qua @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID nhận thông báo (lấy qua @userinfobot)
TELEGRAM_CHAT_ID=

# ----------------- CEX API KEYS (Tùy chọn - Chỉ cần quyền READ cho Paper Trading) -----------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ----------------- CƠ SỞ DỮ LIỆU & STORAGE -----------------
DATABASE_URL=sqlite+aiosqlite:///./data/sentinel.db
